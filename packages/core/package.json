{
  "name": "@envzen/core",
  "version": "0.1.1",
  "description": "Type-safe environment variable validation engine",
  "license": "MIT",
  "author": "EnvZen Contributors",
  "homepage": "https://github.com/madeburo/envzen/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/madeburo/envzen.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/madeburo/envzen/issues"
  },
  "keywords": [
    "env",
    "environment",
    "validation",
    "typescript",
    "zod",
    "type-safe",
    "config",
    "dotenv",
    "schema"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0"
  }
}
