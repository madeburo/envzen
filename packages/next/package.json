{
  "name": "@envzen/next",
  "version": "0.1.1",
  "description": "Next.js adapter for envzen",
  "license": "MIT",
  "author": "EnvZen Contributors",
  "homepage": "https://github.com/madeburo/envzen/tree/main/packages/next#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/madeburo/envzen.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/madeburo/envzen/issues"
  },
  "keywords": [
    "envzen",
    "nextjs",
    "next",
    "env",
    "validation",
    "config"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --out-dir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@envzen/core": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0"
  }
}
