{
  "name": "@envshield/cli",
  "version": "0.1.1",
  "description": "CLI tool for envshield — sync, check, init",
  "license": "MIT",
  "author": "EnvShield Contributors",
  "homepage": "https://github.com/madeburo/envshield/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/madeburo/envshield.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/madeburo/envshield/issues"
  },
  "keywords": [
    "envshield",
    "cli",
    "env",
    "environment",
    "validation",
    "dotenv",
    "sync",
    "check"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "bin": {
    "envshield": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --out-dir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@envshield/core": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0"
  }
}
