{
  "name": "@envzen/nestjs",
  "version": "0.1.1",
  "description": "NestJS adapter for envzen",
  "license": "MIT",
  "author": "EnvZen Contributors",
  "homepage": "https://github.com/madeburo/envzen/tree/main/packages/nestjs#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/madeburo/envzen.git",
    "directory": "packages/nestjs"
  },
  "bugs": {
    "url": "https://github.com/madeburo/envzen/issues"
  },
  "keywords": [
    "envzen",
    "nestjs",
    "nest",
    "env",
    "validation",
    "module"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --out-dir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@envzen/core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "@nestjs/core": { "optional": true }
  },
  "devDependencies": {
    "tsup": "^8.0.0"
  }
}
