{
  "name": "@envguard/vite",
  "version": "0.1.1",
  "description": "Vite adapter for envguard",
  "license": "MIT",
  "author": "EnvGuard Contributors",
  "homepage": "https://github.com/madeburo/envguard/tree/main/packages/vite#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/madeburo/envguard.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/madeburo/envguard/issues"
  },
  "keywords": [
    "envguard",
    "vite",
    "plugin",
    "env",
    "validation",
    "build"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --out-dir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@envguard/core": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": { "optional": true }
  },
  "devDependencies": {
    "tsup": "^8.0.0"
  }
}
